init -2 python:
    renpy.music.register_channel("sounds_m", "music", loop=False)

init python:

    config.windows_icon = "icon.ico"
    config.windows_icon = "icon.png"
    config.windows_icon = "icon"

    def narr(event, **kwargs):
        if event == "show":
            renpy.music.play("narr.wav", channel="sounds_m", loop=True)
        elif event == "slow_done" or event == "end":
            renpy.music.stop(channel="sounds_m", fadeout=0.3)


    def eii(event, **kwargs):
        if event == "show":
            renpy.music.play("eii.wav", channel="sounds_m", loop=True)
        elif event == "slow_done" or event == "end":
            renpy.music.stop(channel="sounds_m", fadeout=0.3)




init -2:
    image ctc_blink:
        xpos 0.83
        ypos 0.9
        "ctc.png"
        linear 0.7 alpha 1.0
        "ctc2.png"
        linear 0.7 alpha 1.0
        repeat



init:
    

    transform shake:
        ease .04 xoffset 26
        ease .04 xoffset -26
        ease .03 xoffset 12
        ease .03 xoffset -12
        ease .02 xoffset 8
        ease .02 xoffset -8
        ease .01 xoffset 4
        ease .01 xoffset -4
        ease .01 xoffset 0

    $ ddp = ImageDissolve(im.Tile("TransMask.png"), 0.5, 0.5)

    image bg1 = "bg1.png"
    image bg2 = "bg2.png"
    image bg3 = "bg3.png"
    image bg4 = "bg4.png"
    image bg5 = "bg5.png"
    image bg52 = "bg52.png"
    image bg6 = "bg6.png"
    image bg7 = "bg7.png"
    image bg8 = "bg8.png"
    image bg9 = "bg9.png"
    image bg10 = "bg10.png"
    image bg11 = "bg11.png"

    image mom = "mom.png"

    image o = "o.png"
    image yo = "yo.png"

    image m1 = "m1.png"
    image m2 = "m2.png"

    image tb = "tb.png"

    image gg1 = "gg1.png"
    
    image kaf = "kaf.png"
    image nkt = "nkt.png"
    image ctrl = "controls.png"

    define n = Character(ctc="ctc_blink", ctc_position="fixed", what_size=45)

    define gg = Character(ctc="ctc_blink", ctc_position="fixed", callback=narr, what_size=45)

    define ei = Character(ctc="ctc_blink", ctc_position="fixed", callback=eii, what_size=45)

    define badend = 0

    define _confirm_quit = False
label splashscreen:
    
    $ renpy.pause(0.5, hard=True)
    
    call screen lang_choice
    $ renpy.pause(1, hard=True)
    
    show kaf 
    
    $ renpy.pause(4, hard=True)

    hide kaf 
    
    $ renpy.pause(1, hard=True)
    
    play sounds_m "fx_intro.mp3"
    
    show nkt 
    
    $ renpy.pause(4, hard=True)

    hide nkt 
    
    $ renpy.pause(1, hard=True)
    
    play sounds_m "fx_intro.mp3"
    
    show ctrl 
    
    $ renpy.pause(6, hard=True)
    
    hide ctrl 
    
    $ renpy.pause(1, hard=True)
    
    return
    
label start:

    $ renpy.block_rollback()

    $ _skipping = False

    stop music fadeout 1

    if badend == 1:
        $ povname = renpy.input(_("Напиши свое имя (как на упаковке)."), length=10)
        $ povname = povname.strip()
        if povname == cname:
            "Снова?"
            "Надеюсь, в этот раз у нас все получится..."

        else:
            "Надеюсь, ты справишься лучше, чем '[cname]'..."


    elif badend == 2:
        $ povname2 = renpy.input(_("Напиши свое имя (как на упаковке)."), length=10)
        $ povname2 = povname.strip()
        if povname2 == povname:
            "Снова?"
            "Надеюсь, в этот раз у нас все получится..."

        else:
            "Надеюсь, ты справишься лучше, чем '[povname]'..."


    else:
        $ cname = renpy.input(_("Напиши свое имя (как на упаковке)."), length=10)
        $ cname = cname.strip()
    $ badend +=1

    $ bend_points = 0

    $ renpy.music.set_volume(0.8)

    $ renpy.pause(1, hard=True)

    show screen keymap_screen

    show tb onlayer master

    show bg3 with ddp

    play music "22.mp3"

    n"Я иду по дороге в магазин и репетирую свою речь."
    n"Я так давно не выбиралась из дома, что напрочь забыла, какие слова нужно произносить при входе в магазин."
    gg"\"Я иду в магазин.\""
    play sounds_m "fx3.mp3"
    menu:
        "(К кому ты обращаешься?)":
            gg"\"Я представляю, будто я персонаж игры - вдруг поможет собраться с мыслями?\""
            jump ch1

        "(Заткнись и иди уже.)":
            $ bend_points += 1
            gg"\"Э-эй... разве ты не должен помогать мне?\""
            jump ch2

label ch1:
    play sounds_m "fx3.mp3"
    menu:
        "(Какой игры?)":
            gg"\"Ну, знаешь...\""
            gg"\"Есть такие игры, где видны мысли персонажа. Прямо на экране, представляешь?\""
            gg"\"Вот я и подумала - если вдруг кто-то читает мои мысли, то мне нужно быть очень сконцентрированной, чтобы не сболтнуть лишнего! Ха-ха!\""
            jump ch2

        "...":
            gg"\"В молчанку играть будем? Ладно уж...\""
            jump ch2

label ch2:

    n"Я набираю полную грудь воздуха."
    gg"\"Здрасьте, а можно?..\""
    n"..."
    n"..."
    n"..."
    n"Блин, забыла."
    n"Девятнадцатая попытка - и снова неудача. Я с досадой кусаю губы."
    gg"\"Так, еще раз...\""
    gg"\"Здрасьте, а можно мне?..\""
    play sounds_m "fx3.mp3"
    menu:
        "(Ого, на целое слово больше!)":
            gg"\"Спасибо, я очень стараюсь...\""
    play sounds_m "fx3.mp3"
    menu:
        "(По-моему, в этот раз звук 'р' был длиннее обычного...)":
            gg"\"Думаешь, в этом и дело?\""
            play sounds_m "fx3.mp3"
            menu:
                "(Кто знает...)":
                    jump ch3

label ch3:

    gg"\"Здр-р-расьте, а...\""
    gg"\"Тьфу, лучше б молчала!\""
    play sounds_m "fx3.mp3"
    menu:
        "(Ха-ха-ха, неудачница!)":
            $ bend_points += 1
            gg"\"Не обижай меня, пожалуйста...\""
        "(Не переживай!)":
            gg"\"Ладно уж...\""
label ch4:

    play sounds_m "fx3.mp3"
    menu:
        "(Кстати, ты уже целую минуту как идешь левой ногой по асфальту, а правой - по траве...)":
            gg"\"Ч-ЧТО?!\""
    n"Моя правая нога застыла в воздухе."
    gg"\"С-сколько?\""
    play sounds_m "fx3.mp3"
    menu:
        "(50 шагов по асфальту и 51 по траве.)":
            play sounds_m "fx3.mp3"
            menu:
                "(Тебе придется отменить предыдущий шаг.)":
                    play sounds_m "fx3.mp3"
                    menu:
                        "(Хе-хе-хе...)":
                            gg"\"К-как ты себе это представляешь?\""
    play sounds_m "fx3.mp3"
    menu:
        "(Это ведь не в первый раз происходит.)":
            play sounds_m "fx3.mp3"
            menu:
                "(Тебя ведь учили, как правильно. Ну же...)":
                    gg"\"Я... я не помню...\""
                    n"Я готова разреветься."
                "(До чего же ты тупая.)":
                    $ bend_points += 1
                    if bend_points > 2:
                        stop music
                        hide m2
                        hide bg3
                        jump end
                    else:
                        gg"\"Прекрати обижать меня!\""
    play sounds_m "fx3.mp3"
    menu:
        "(Эх, опять все по новой.)":
            play sounds_m "fx3.mp3"
            menu:
                "(Итак.)":
                    play sounds_m "fx3.mp3"
                    menu:
                        "(Шаг первый - сделай шаг назад, чтобы попасть ногой ровно в свой же след...)":
                            gg"\"Постой, постой! Как это 'шаг первый'?\""
    play sounds_m "fx3.mp3"
    menu:
        "(А какой тогда?)":
            gg"\"Получается, уже 52-й! Хотя погоди, я ведь иду назад... тогда 50-й! Что-то все равно не сходится!\""
    play sounds_m "fx3.mp3"
    menu:
        "(Хорошо, хорошо... Шаг 50-й - сделай шаг назад, чтобы попасть ногой ровно в свой же след.)":
            gg"\"А можно было хоть чуть-чуть перефразировать?\""
            gg"\"Нельзя вот так просто повторить фразу, не поменяв хотя бы одного слова. Люди так не разговаривают!\""
    play sounds_m "fx3.mp3"
    menu:
        "(Ты совсем безнадежна...)":
            gg"\"Говоришь, будто я во всем виновата...\""
    play sounds_m "fx3.mp3"
    menu:
        "(Магазин закрывается через час, так что...)":
            play sounds_m "fx3.mp3"
            menu:
                "(Ты будешь очень, очень виновата, если не купишь молока.)":
                    gg"\"Блин, и в самом деле!..\""
    play sounds_m "fx3.mp3"
    menu:
        "(Ну? Ты готова?)":
            gg"\"Да, черт возьми, да!\""
    n"Я аккуратно переставляю ногу назад, внимательно всматриваясь в густую траву..."

    stop music fadeout 1

    hide bg3 with ddp

    $ renpy.pause(1, hard=True)

    show bg2 with ddp

    n"Войдя в магазин, я обратилась к первому же попавшемуся человеку."
    gg"\"Здрасьте, а можно!..\""

    play music "3.mp3"

    show m1 with ddp

    $ renpy.pause(4, hard=True)

    show m1 at shake
    ei"\"O\""
    gg"\"Что, простите?\""
    show m1 at shake
    ei"{size=+5}\"O\"{/size}"
    gg"{size=+5}\"Что, простите?\"{/size}"
    show m1 at shake
    ei"{size=+10}\"O\"{/size}"
    gg"{size=+10}\"Что, простите?\"{/size}"
    show m1 at shake
    ei"{size=+15}\"O\"{/size}"
    gg"{size=+15}\"Что, простите?\"{/size}"
    show m1 at shake
    ei"{size=+20}\"O\"{/size}"
    gg"{size=+20}\"Что, простите?\"{/size}"
    show m1 at shake
    ei"{size=+25}\"O\"{/size}"
    play sounds_m "fx3.mp3"
    menu:
        "(Зря ты это затеяла...)":
            play sounds_m "fx3.mp3"
            menu:
                "(Он явно не собирается менять своих реплик. Ты рискуешь угодить в бесконечную петлю...)":
                    jump ch5

label ch5:
    gg"\"Что, простите?\""
    show m1 at shake
    ei"\"O\""
    gg"{size=+5}\"Что, простите?\"{/size}"
    show m1 at shake
    ei"{size=+10}\"O\"{/size}"
    gg"{size=+10}\"Что, простите?\"{/size}"
    show m1 at shake
    ei"{size=+15}\"O\"{/size}"
    gg"{size=+35}\"Что, простите?\"{/size}"
    show m1 at shake
    ei"{size=+20}\"O\"{/size}"
    gg"{size=-20}\"Что, простите?\"{/size}"
    show m1 at shake
    ei"{size=-30}\"O\"{/size}"
    gg"\"Что?\""
    show m1 at shake
    ei"\"O\""
    play sounds_m "fx3.mp3"
    menu:
        "(Что он пытается тебе сказать?)":
            gg"\"Он пытается испугать меня. Но откуда он знает, что я панически боюсь буквы 'О'?\""
            play sounds_m "fx3.mp3"
            menu:
                "(Чего же в ней такого страшного?)":
                    gg"\"У меня возникает пугающий образ, стоит мне представить ее в голове...\""
                    gg"\"Я могу показать. Объяснять все равно не имеет смысла, но учти, что это будет стоить мне с десяток нервых клеток...{nw}\""
                    hide m1
                    hide bg2
                    hide tb
                    stop music
                    $ renpy.music.set_volume(1.0)
                    show o:
                        subpixel True
                        truecenter
                        zoom 1.0
                        ease 10.0 zoom 1.5
                    play music "10.mp3"

                    $ renpy.pause(8, hard=True)

                    hide o
                    stop music
                    show bg2
                    show m1
                    show tb
                    $ renpy.music.set_volume(0.8)
                    play music "3.mp3"
                    gg"Как-то так..."
                    gg"\"В общем, я буду продолжать игнорировать его вопрос.\""
            jump ch6

label ch6:
    gg"\"Что?\""
    show m1 at shake
    ei"\"O\""
    gg"\"Что?\""
    show m1 at shake
    ei"\"O\""
    gg"\"Что?\""
    show m1 at shake
    ei"\"O\""
    gg"{size=+90}\"Ч              т               о               ?\"{/size}"
    show m1 at shake
    ei"\"O\""

    n"Я собираю всю волю в кулак..."
    gg"\"О?\""

    $ renpy.pause(2, hard=True)

    show m1 at shake
    ei"\"O!\""

    hide m1 with ddp

    $ achievement.grant("Achievement01_O!1")
    init:
        $ achievement.register("Achievement01_O!1")
        $ achievement.sync()

    $ achievement.Sync()

    n"Мой собеседник затрясся и уполз."
    play sounds_m "fx3.mp3"
    menu:
        "(Ты просто повторила за ним...)":
            play sounds_m "fx3.mp3"

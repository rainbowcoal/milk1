    gg "\"Może kiedyś ci opowiem.\""

# game/bad.rpy:708
translate polski die_a93efda8:

    # gg "\"Ну смотри. Соотношение воды и молока в объеме воздуха, занимаемом мной - примерно тридцать к одному.\""
